#!/usr/bin/env bash

abspath="$1"; lf_previewbox_x="$4"; lf_previewbox_y="$5"; lf_previewbox_w="$2"; lf_previewbox_h="$3"

preview_image() {
    filepath="$1"

	chafa --animate false --view-size "${lf_previewbox_w}x${lf_previewbox_h}" "$filepath"
}

preview_archive() {
    filepath="$1"

    case "$1" in
    *.tar|*.tar.*)
        tar -tf "$filepath"
        ;;
    *.zip)
        zipinfo -1 "$filepath"
        ;;
    *.7z)
        # https://stackoverflow.com/a/68070379
        7z l -ba "$filepath" | grep -oP '(?<=^.{53}).*'
        ;;
    *.rar)
        rar lb "$filepath"
        ;;
    *)
        echo "unknown archive format"
        ;;
    esac | tree -L 1 -F --dirsfirst --noreport --fromfile .
}

