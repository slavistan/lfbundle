# Determine the number of lines required for the full filename to be displayed
# and add that to the y-offset for image previews. Add another offset for the
# horizontal separator line.

THUMBNAIL_ABSPATH="$LFBUNDLE_TEMPDIR/thumbnail.png" # thumbnail path for ad-hoc conversions

# TODO: line wrapping
#       lf doesn't automatically wrap the output inside the viewbox.
generate_preview() (
	ERROR_PREVIEW=1
	ERROR_NO_PREVIEWER_CONFIGURED_FOR_FILE=2
	trap "exit $ERROR_PREVIEW" ERR
	set -eo pipefail
	filepath="$1"

	filename="$(basename "$filepath")"
	case "$(echo "$filename" | tr '[:upper:]' '[:lower:]')" in
	*.pdf|*.ps)
		gs -o "$THUMBNAIL_ABSPATH" -sDEVICE=pngalpha "$filepath" >/dev/null
		preview_image "$THUMBNAIL_ABSPATH"
		;;
	*.jpg|*.jpeg|*.png|*.bmp|*.tiff|*.gif|*.svg)
		preview_image "$filepath"
		;;
	*.avi|*.webm|*.webp|*.mp4|*.mkv)
		ffmpeg -y -i "$filepath" -vframes 1 "$THUMBNAIL_ABSPATH"
		preview_image "$THUMBNAIL_ABSPATH"
		;;
	*.tar|*.tar.*|*.7z|*.rar|*.zip)
		preview_archive "$filepath"
		;;
	# *.iso)
	# 	iso-info --no-header "$filepath"
	# 	;;
	*.drawio)
		echo TODO
		;;
	*)
		if file -b --mime-type "$filepath" | grep -q '^application\/'; then
			return "$ERROR_NO_PREVIEWER_CONFIGURED_FOR_FILE"
		else
			bat --style plain --color always "$filepath"
		fi
		;;
	esac
)

preview="$(generate_preview "$FILEPATH_ABS")"
case "$?" in
0)
	echo "$preview"
	;;
1)
	echo "Error generating preview, using 'file':"
	file "$FILEPATH_ABS"
	;;
2)
	echo "No previewer configured for file, using 'file':"
	file "$FILEPATH_ABS"
	;;
esac
